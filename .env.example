# ─── Supabase ──────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (used server-side only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── PostgreSQL (Supabase connection strings) ───────────────────────────────
# Get from: Supabase → Settings → Database → Connection string
# Use the "Transaction" pooler URL for DATABASE_URL (Vercel serverless needs this)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Use the direct URL for migrations
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Google Gemini ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=nyayadraft-documents

# ─── Inngest ───────────────────────────────────────────────────────────────
# Get from: https://app.inngest.com → Manage → Keys
# Leave blank for local dev (Inngest Dev Server auto-discovers)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Legal Source Connectors ────────────────────────────────────────────────
# Comma-separated list of connector IDs to enable
# Current options: india-code
# Future (after implementing): india-code,ecourts,scc-online,manupatra
ENABLED_CONNECTORS=india-code

# ─── Stripe (future — for SaaS billing) ────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
